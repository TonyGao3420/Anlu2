# =============================================================================
# 文件名 : anlu2_timing.sdc
# 功能   : 时序约束（时钟与跨时钟域）
# 说明   : 安路 TD 的时钟约束用 create_clock；跨时钟域路径用 set_false_path。
#          本工程的时钟全部由 PLL 产生，因此这里只约束输入参考时钟，
#          PLL 输出时钟由 TD 依据 IP 参数自动派生（见 src/vendor/PLL.v 的注释：
#          C0=100MHz, C1=23.809524MHz, C4=75MHz, C5=375MHz）。
# =============================================================================

# ---------------------------------------------------------------------------
# 输入参考时钟：50MHz 系统时钟
# ---------------------------------------------------------------------------
create_clock -period 20.000 -name sys_clk_50m [get_ports I_sys_clk]

# ---------------------------------------------------------------------------
# PLL 输出时钟（若 TD 未自动派生，可手工补上）
# ---------------------------------------------------------------------------
# create_clock -period 10.000  -name pll_clk_100m  [get_pins u_pll/clk0_out]
# create_clock -period 42.000  -name pll_clk_24m   [get_pins u_pll/clk1_out]
# create_clock -period 13.333  -name hdmi_pixel_clk [get_pins u_pll/clk4_out]
# create_clock -period  2.667  -name hdmi_serial_clk [get_pins u_pll/clk5_out]

# ---------------------------------------------------------------------------
# 异步跨时钟域：MIPI 字节时钟域 <-> HDMI 像素时钟域
# 这两个域之间没有直接的组合逻辑通路（帧缓存/异步 FIFO 承担跨域），
# 因此对它们之间的路径设 false path，避免工具做无意义的时序分析。
# ---------------------------------------------------------------------------
# set_false_path -from [get_clocks hdmi_pixel_clk]  -to [get_clocks mipi_rx_byte_clk]
# set_false_path -from [get_clocks mipi_rx_byte_clk] -to [get_clocks hdmi_pixel_clk]

# ---------------------------------------------------------------------------
# 异步复位与按键输入：与系统时钟无关，设为 false path
# ---------------------------------------------------------------------------
set_false_path -from [get_ports I_rst_n]
set_false_path -from [get_ports I_button[*]]

# ---------------------------------------------------------------------------
# 注意（重要）：
# 官方 SC520CS 例程的综合报告 gate.qor 显示 MIPI_RX_BYTE_CLK 域存在
# Setup WNS = -2121ps 的时序违例（两条路径）。本工程沿用同一 MIPI 接收
# 硬核与同等速率，因此**很可能继承同一问题**。建议：
#   1) 先跑 opt_gate 看实际 WNS；
#   2) 若确实违例，优先在 MIPI RX 输出到 csi2_rx_unpack 之间插入寄存器
#      打拍（降低 MIPI_RX_BYTE_CLK 域的组合级数）；
#   3) 或用 TD 的时序例外/多周期约束针对性放宽该路径。
# 详细的实测结果记录在 doc/architecture.md。
# ---------------------------------------------------------------------------
