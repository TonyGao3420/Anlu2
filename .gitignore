*.log
*.rpt
*.jou
*.str
*.al
*.prj
*.bak

# 安路生成的输出文件夹与编译缓存
*.runs/
*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.data/

# 生成的烧录文件与比特流 (不需要版本控制)
*.bit
*.bin
*.fs
*.svf
*.pof

# ==========================================
# 2. 仿真软件相关 (ModelSim / Questa 等)
# ==========================================
# 仿真编译产生的庞大工作库 (必须忽略，否则极易冲突)
work/
*.vcd
*.wlf
*.wdb
transcript
vsim.wlf
modelsim.ini

# 仿真波形文件
*.wave
*.do.bak

# ==========================================
# 3. 操作系统与编辑器通用文件
# ==========================================
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# VS Code
.vscode/

# 文本编辑器备份
*~
*.bak
*.tmp


